ENVIRONMENT=production
# Create a libSQL-engine Turso Cloud database, not the separate Turso engine.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=
INTERNAL_API_TOKEN=
# Replace the reserved example hostname with your actual Render/custom hostname.
ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
LLM_PROVIDER=disabled
OPENAI_API_KEY=
LLM_MODEL=
MAX_WORKSPACES=500
GLOBAL_TEXT_BYTES=536870912
